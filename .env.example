# Local build configuration. This file is intentionally ignored by Git.
# Values are 0 (disabled) or 1 (enabled) unless documented otherwise.

WHISPER_CPP_REPO=https://github.com/ggml-org/whisper.cpp.git
WHISPER_CPP_REF=v1.9.1

SOURCE_DIR=/pool/cache/whisper/source
BUILD_DIR=/pool/build/whisper/host-native
OUTPUT_DIR=/pool/build/whisper/output
MODEL_DIR=/pool/cache/whisper/models

# This host profile stores managed build artifacts outside the repository.
ALLOW_EXTERNAL_DIRS=1

# auto prefers Ninja when present, otherwise Unix Makefiles.
CMAKE_GENERATOR=auto
BUILD_JOBS=auto
CMAKE_C_COMPILER=
CMAKE_CXX_COMPILER=

# This profile produces a host-only binary for the current CPU.
GGML_NATIVE=1
ENABLE_LTO=1
# Disable upstream cache auto-detection; use the explicit sccache launchers below.
ENABLE_CCACHE=0
ENABLE_OPENMP=1
ENABLE_CPU_REPACK=1

# Project-scoped compilation cache. SCCACHE_DIR is exported only to this build's
# CMake process and its compiler children; it does not alter system-wide cache
# configuration.
SCCACHE_DIR=/pool/cache/whisper/sccache
CMAKE_C_COMPILER_LAUNCHER=sccache
CMAKE_CXX_COMPILER_LAUNCHER=sccache

# Keep CMake's base C/C++ flags host-native in addition to GGML_NATIVE.
CMAKE_C_FLAGS=-march=native
CMAKE_CXX_FLAGS=-march=native

# More aggressive global floating-point transformations. Keep 0 for conservative
# numerical behavior; GGML still uses its optimized kernels either way.
ENABLE_FAST_MATH=0

# Optional CPU encoder acceleration. Requires OpenBLAS development files.
ENABLE_BLAS=0
BLAS_VENDOR=OpenBLAS

# Enable at most one primary GPU backend per build profile.
ENABLE_CUDA=0
CUDA_ARCHS=auto
ENABLE_CUDA_FA=1
CUDA_FORCE_MMQ=0
CUDA_FORCE_CUBLAS=0

ENABLE_HIP=0
AMDGPU_TARGETS=auto

ENABLE_VULKAN=0

# Intel oneAPI / Intel GPU backend.
ENABLE_SYCL=0
ENABLE_SYCL_F16=0
SYCL_TARGET=INTEL
SYCL_DEVICE_ARCH=

# Whisper encoder offload through OpenVINO. This also requires an OpenVINO
# encoder model beside the selected GGML model at runtime.
ENABLE_OPENVINO=0

# Broader input codec support in whisper-cli. Requires FFmpeg development libs.
ENABLE_FFMPEG=0

STRIP_BINARY=1
# OFFLINE=1 forbids both source fetching and new model downloads.
OFFLINE=0
SOURCE_UPDATE=0
FORCE_SOURCE_RESET=0

# Optional Hugging Face token. Never commit a real token.
HF_TOKEN=
STRICT_RESOURCES=0
FORCE_DOWNLOAD=0
RUNTIME_THREADS=auto

# Whitespace-delimited expert overrides. Avoid shell metacharacters.
EXTRA_CMAKE_ARGS=
EXTRA_C_FLAGS=
EXTRA_CXX_FLAGS=
