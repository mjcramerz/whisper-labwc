# Tracked build configuration. Keep this file synchronized with .env.example.
# Put credentials and machine-only overrides in ignored .env.local.
# Boolean values are 0 (disabled) or 1 (enabled) unless documented otherwise.

WHISPER_CPP_REPO=https://github.com/ggml-org/whisper.cpp.git
WHISPER_CPP_REF=v1.9.1

# Shared, repository-owned downloads. RAM and CUDA builds never reuse an
# unrelated checkout: this wrapper creates and stamps this source directory.
SOURCE_DIR=/pool/cache/whisper-labwc/source
MODEL_DIR=/pool/cache/whisper-labwc/models

# Generic `make build` profile. Prefer build-ram or build-cuda below.
BUILD_PROFILE=native
BUILD_DIR=/pool/build/whisper-labwc/native
OUTPUT_DIR=/pool/build/whisper-labwc/output/native
ARCHIVE_PATH=/pool/build/whisper-labwc/artifacts/whisper-native.tar.gz

# Managed directories intentionally live outside the repository.
ALLOW_EXTERNAL_DIRS=1

# Generic toolchain defaults used by `make build` and direct script execution.
CMAKE_GENERATOR=auto
BUILD_JOBS=auto
CMAKE_C_COMPILER=
CMAKE_CXX_COMPILER=
CMAKE_CUDA_COMPILER=
CMAKE_CUDA_HOST_COMPILER=
CMAKE_C_COMPILER_LAUNCHER=sccache
CMAKE_CXX_COMPILER_LAUNCHER=sccache
CMAKE_CUDA_COMPILER_LAUNCHER=
CMAKE_C_FLAGS=-march=native
CMAKE_CXX_FLAGS=-march=native
CMAKE_CUDA_FLAGS=
SCCACHE_DIR=/pool/cache/whisper-labwc/sccache/native
SCCACHE_SERVER_UDS=/pool/cache/whisper-labwc/sccache/native/server.sock
BUILD_CLI=1
BUILD_SERVER=1
GGML_NATIVE=1
ENABLE_LTO=1
ENABLE_CCACHE=0
ENABLE_OPENMP=1
ENABLE_CPU_REPACK=1
ENABLE_FAST_MATH=0
ENABLE_BLAS=0
BLAS_VENDOR=OpenBLAS
ENABLE_CUDA=0
CUDA_ARCHS=auto
ENABLE_CUDA_FA=1
ENABLE_CUDA_FA_ALL_QUANTS=0
CUDA_FORCE_MMQ=0
CUDA_FORCE_CUBLAS=0
CUDA_NO_PEER_COPY=0
CUDA_NO_VMM=0
ENABLE_CUDA_GRAPHS=0
ENABLE_CUDA_NCCL=0
CUDA_COMPRESSION_MODE=size
ENABLE_CUDA_GLIBC_COMPAT=0
CUDA_GLIBC_HEADER=
CUDA_GLIBC_COMPAT_DIR=
ENABLE_HIP=0
AMDGPU_TARGETS=auto
ENABLE_VULKAN=0
ENABLE_SYCL=0
ENABLE_SYCL_F16=0
SYCL_TARGET=INTEL
SYCL_DEVICE_ARCH=
ENABLE_OPENVINO=0
ENABLE_FFMPEG=0
STRIP_BINARY=1
EXTRA_CMAKE_ARGS=
EXTRA_C_FLAGS=
EXTRA_CXX_FLAGS=
EXTRA_CUDA_FLAGS=

# CPU/RAM profile: CPU-native Release binaries, OpenMP, repacked CPU kernels,
# LTO, and a dedicated sccache/build/output/archive path.
WHISPER_RAM_SOURCE_DIR=/pool/cache/whisper-labwc/source
WHISPER_RAM_BUILD_DIR=/pool/build/whisper-labwc/ram
WHISPER_RAM_OUTPUT_DIR=/pool/build/whisper-labwc/output/ram
WHISPER_RAM_MODEL_DIR=/pool/cache/whisper-labwc/models
WHISPER_RAM_ARCHIVE_PATH=/pool/build/whisper-labwc/artifacts/whisper-ram.tar.gz
WHISPER_RAM_SCCACHE_DIR=/pool/cache/whisper-labwc/sccache/ram
WHISPER_RAM_SCCACHE_SERVER_UDS=/pool/cache/whisper-labwc/sccache/ram/server.sock
WHISPER_RAM_CMAKE_GENERATOR=auto
WHISPER_RAM_BUILD_JOBS=auto
WHISPER_RAM_CMAKE_C_COMPILER=
WHISPER_RAM_CMAKE_CXX_COMPILER=
WHISPER_RAM_CMAKE_CUDA_COMPILER=
WHISPER_RAM_CMAKE_CUDA_HOST_COMPILER=
WHISPER_RAM_CMAKE_C_COMPILER_LAUNCHER=sccache
WHISPER_RAM_CMAKE_CXX_COMPILER_LAUNCHER=sccache
WHISPER_RAM_CMAKE_CUDA_COMPILER_LAUNCHER=
WHISPER_RAM_CMAKE_C_FLAGS=-march=native
WHISPER_RAM_CMAKE_CXX_FLAGS=-march=native
WHISPER_RAM_CMAKE_CUDA_FLAGS=
WHISPER_RAM_BUILD_CLI=1
WHISPER_RAM_BUILD_SERVER=1
WHISPER_RAM_GGML_NATIVE=1
WHISPER_RAM_ENABLE_LTO=1
WHISPER_RAM_ENABLE_CCACHE=0
WHISPER_RAM_ENABLE_OPENMP=1
WHISPER_RAM_ENABLE_CPU_REPACK=1
WHISPER_RAM_ENABLE_FAST_MATH=0
WHISPER_RAM_ENABLE_BLAS=0
WHISPER_RAM_BLAS_VENDOR=OpenBLAS
WHISPER_RAM_ENABLE_CUDA=0
WHISPER_RAM_CUDA_ARCHS=auto
WHISPER_RAM_ENABLE_CUDA_FA=0
WHISPER_RAM_ENABLE_CUDA_FA_ALL_QUANTS=0
WHISPER_RAM_CUDA_FORCE_MMQ=0
WHISPER_RAM_CUDA_FORCE_CUBLAS=0
WHISPER_RAM_CUDA_NO_PEER_COPY=0
WHISPER_RAM_CUDA_NO_VMM=0
WHISPER_RAM_ENABLE_CUDA_GRAPHS=0
WHISPER_RAM_ENABLE_CUDA_NCCL=0
WHISPER_RAM_CUDA_COMPRESSION_MODE=size
WHISPER_RAM_ENABLE_CUDA_GLIBC_COMPAT=0
WHISPER_RAM_CUDA_GLIBC_HEADER=
WHISPER_RAM_CUDA_GLIBC_COMPAT_DIR=
WHISPER_RAM_ENABLE_HIP=0
WHISPER_RAM_AMDGPU_TARGETS=auto
WHISPER_RAM_ENABLE_VULKAN=0
WHISPER_RAM_ENABLE_SYCL=0
WHISPER_RAM_ENABLE_SYCL_F16=0
WHISPER_RAM_SYCL_TARGET=INTEL
WHISPER_RAM_SYCL_DEVICE_ARCH=
WHISPER_RAM_ENABLE_OPENVINO=0
WHISPER_RAM_ENABLE_FFMPEG=0
WHISPER_RAM_STRIP_BINARY=1
WHISPER_RAM_EXTRA_CMAKE_ARGS=
WHISPER_RAM_EXTRA_C_FLAGS=
WHISPER_RAM_EXTRA_CXX_FLAGS=
WHISPER_RAM_EXTRA_CUDA_FLAGS=

# NVIDIA Quadro P520 profile. The P520 is targeted explicitly as sm_61.
# This is a single-GPU profile: peer copies and NCCL are disabled. Flash
# Attention kernels are compiled, while all-quant expansion and forced kernel
# selection stay disabled so ggml can choose MMQ/cuBLAS at runtime.
WHISPER_CUDA_SOURCE_DIR=/pool/cache/whisper-labwc/source
WHISPER_CUDA_BUILD_DIR=/pool/build/whisper-labwc/cuda
WHISPER_CUDA_OUTPUT_DIR=/pool/build/whisper-labwc/output/cuda
WHISPER_CUDA_MODEL_DIR=/pool/cache/whisper-labwc/models
WHISPER_CUDA_ARCHIVE_PATH=/pool/build/whisper-labwc/artifacts/whisper-cuda.tar.gz
WHISPER_CUDA_SCCACHE_DIR=/pool/cache/whisper-labwc/sccache/cuda
WHISPER_CUDA_SCCACHE_SERVER_UDS=/pool/cache/whisper-labwc/sccache/cuda/server.sock
WHISPER_CUDA_CMAKE_GENERATOR=auto
WHISPER_CUDA_BUILD_JOBS=auto
WHISPER_CUDA_CMAKE_C_COMPILER=/usr/bin/gcc-14
WHISPER_CUDA_CMAKE_CXX_COMPILER=/usr/bin/g++-14
WHISPER_CUDA_CMAKE_CUDA_COMPILER=/usr/local/cuda-12.8/bin/nvcc
WHISPER_CUDA_CMAKE_CUDA_HOST_COMPILER=/usr/bin/g++-14
WHISPER_CUDA_CMAKE_C_COMPILER_LAUNCHER=sccache
WHISPER_CUDA_CMAKE_CXX_COMPILER_LAUNCHER=sccache
WHISPER_CUDA_CMAKE_CUDA_COMPILER_LAUNCHER=
WHISPER_CUDA_CMAKE_C_FLAGS=-march=native
WHISPER_CUDA_CMAKE_CXX_FLAGS=-march=native
WHISPER_CUDA_CMAKE_CUDA_FLAGS=
WHISPER_CUDA_BUILD_CLI=1
WHISPER_CUDA_BUILD_SERVER=1
WHISPER_CUDA_GGML_NATIVE=1
WHISPER_CUDA_ENABLE_LTO=1
WHISPER_CUDA_ENABLE_CCACHE=0
WHISPER_CUDA_ENABLE_OPENMP=1
WHISPER_CUDA_ENABLE_CPU_REPACK=1
WHISPER_CUDA_ENABLE_FAST_MATH=0
WHISPER_CUDA_ENABLE_BLAS=0
WHISPER_CUDA_BLAS_VENDOR=OpenBLAS
WHISPER_CUDA_ENABLE_CUDA=1
WHISPER_CUDA_CUDA_ARCHS=61
WHISPER_CUDA_ENABLE_CUDA_FA=1
WHISPER_CUDA_ENABLE_CUDA_FA_ALL_QUANTS=0
WHISPER_CUDA_CUDA_FORCE_MMQ=0
WHISPER_CUDA_CUDA_FORCE_CUBLAS=0
WHISPER_CUDA_CUDA_NO_PEER_COPY=1
WHISPER_CUDA_CUDA_NO_VMM=0
WHISPER_CUDA_ENABLE_CUDA_GRAPHS=0
WHISPER_CUDA_ENABLE_CUDA_NCCL=0
WHISPER_CUDA_CUDA_COMPRESSION_MODE=size
WHISPER_CUDA_ENABLE_CUDA_GLIBC_COMPAT=1
WHISPER_CUDA_CUDA_GLIBC_HEADER=/usr/local/cuda-12.8/targets/x86_64-linux/include/crt/math_functions.h
WHISPER_CUDA_CUDA_GLIBC_COMPAT_DIR=/pool/cache/whisper-labwc/cuda-compat/12.8
WHISPER_CUDA_ENABLE_HIP=0
WHISPER_CUDA_AMDGPU_TARGETS=auto
WHISPER_CUDA_ENABLE_VULKAN=0
WHISPER_CUDA_ENABLE_SYCL=0
WHISPER_CUDA_ENABLE_SYCL_F16=0
WHISPER_CUDA_SYCL_TARGET=INTEL
WHISPER_CUDA_SYCL_DEVICE_ARCH=
WHISPER_CUDA_ENABLE_OPENVINO=0
WHISPER_CUDA_ENABLE_FFMPEG=0
WHISPER_CUDA_STRIP_BINARY=1
WHISPER_CUDA_EXTRA_CMAKE_ARGS=
WHISPER_CUDA_EXTRA_C_FLAGS=
WHISPER_CUDA_EXTRA_CXX_FLAGS=
WHISPER_CUDA_EXTRA_CUDA_FLAGS=

# Source/model runtime controls shared by all profiles.
OFFLINE=0
SOURCE_UPDATE=0
FORCE_SOURCE_RESET=0
STRICT_RESOURCES=0
FORCE_DOWNLOAD=0
RUNTIME_THREADS=auto

# Never commit a token here. Put HF_TOKEN=... in ignored .env.local or export it.
HF_TOKEN=
